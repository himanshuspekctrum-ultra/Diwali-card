{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/card",
      "destination": "/api/card.js"
    },
    {
      "source": "/api/health",
      "destination": "/api/health.js"
    },
    {
      "source": "/api/batch",
      "destination": "/api/batch.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    }
  ]
}
